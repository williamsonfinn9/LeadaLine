# ============================================================
# LeadaLine — environment variables (server-side only)
# Copy to your Vercel project settings. NEVER commit real values.
# ============================================================

# --- Site & booking -----------------------------------------
# Public origin used to build report/unsubscribe links in emails & webhooks
PUBLIC_SITE_URL=https://www.leadaline.com
# Booking destination for report CTAs (path or absolute URL)
PUBLIC_BOOKING_URL=/book-a-demo.html

# --- Supabase (already set for existing functions) ----------
SUPABASE_URL=https://icshqgpsehddcqwydjxc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (already set for prospect-intelligence) -------------
ANTHROPIC_API_KEY=
# Optional model override for audit narrative generation
AI_MODEL=claude-opus-5

# --- Email delivery (Resend) — optional ---------------------
# Leave empty to disable email sending (audit still works fully)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=LeadaLine <hello@leadaline.com>

# --- Make.com webhooks — optional ---------------------------
# Leave empty to disable owner notifications
MAKE_WEBHOOK_URL=
# Shared secret for HMAC signing (header: x-leadaline-signature)
MAKE_WEBHOOK_SECRET=

# --- Audit security -----------------------------------------
# Random secret used to sign unsubscribe links (generate: openssl rand -hex 32)
AUDIT_REPORT_SECRET=

# --- Internal CRM access ------------------------------------
# Comma-separated Supabase Auth emails allowed to view /contractor-audit/admin
ADMIN_EMAILS=hello@leadaline.com,admin@leadaline.com

# --- Optional integrations (not required for MVP) -----------
# PAGESPEED_API_KEY=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
